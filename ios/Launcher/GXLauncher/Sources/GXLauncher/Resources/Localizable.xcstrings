    },
    "The game can only start once every archive is on this iPhone. Keep the app open, or move the folder to On My iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game can only start once every archive is on this iPhone. Keep the app open, or move the folder to On My iPhone."
          }
        }
      }
    },
    "The game data (the .big archives) is not included: it comes from your own copy of Zero Hour. Copy the game folder to Files › On My iPhone and choose it on Home.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game data (the .big archives) is not included: it comes from your own copy of Zero Hour. Copy the game folder to Files › On My iPhone and choose it on Home."
          }
        }
      }
    },
    "The game data folder is missing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game data folder is missing."
          }
        }
      }
    },
    "The game itself always runs at 60 updates a second. 120 makes scrolling and animation smoother on ProMotion screens and uses more battery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game itself always runs at 60 updates a second. 120 makes scrolling and animation smoother on ProMotion screens and uses more battery."
          }
        }
      }
    },
    "The game may fail to start or show missing textures. See Home > Game folder for details.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game may fail to start or show missing textures. See Home > Game folder for details."
          }
        }
      }
    },
    "The game writes its log while it runs. Play once, then come back here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game writes its log while it runs. Play once, then come back here."
          }
        }
      }
    },
    "The game's log from the last session and the one before it. Share it with a bug report.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game's log from the last session and the one before it. Share it with a bug report."
          }
        }
      }
    },
    "These turn on extra logging for bug reports. Leave them all off for normal play: they can slow the game down or produce large logs. If someone asks you to turn one on, enable it, reproduce the problem, then share the log.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These turn on extra logging for bug reports. Leave them all off for normal play: they can slow the game down or produce large logs. If someone asks you to turn one on, enable it, reproduce the problem, then share the log."
          }
        }
      }
    },
    "This app does not include the game data": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app does not include the game data"
          }
        }
      }
    },
    "This folder is read-only, so the port's files could not be copied into it. The game uses the app's own fonts and settings instead, but its interface fixes (Window layouts) will be missing. Move the folder to On My iPhone to fix this.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is read-only, so the port's files could not be copied into it. The game uses the app's own fonts and settings instead, but its interface fixes (Window layouts) will be missing. Move the folder to On My iPhone to fix this."
          }
        }
      }
    },
